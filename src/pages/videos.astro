---
import "../styles/global.css";

const BASE_PATH = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aprende palabras en mazahua jugando con imágenes y sonidos." />
    <meta name="theme-color" content="#eee7ff" />
    <title>Videos | Lotería Mazahua</title>

    <style>
      :root {
        --lavanda: #eee7ff;
        --morado: #8862dc;
        --morado-oscuro: #6543b5;
        --rosa: #ffdce8;
        --rosa-fuerte: #f47ca8;
        --menta: #e4f8e4;
        --verde: #269354;
        --azul: #e2f5ff;
        --azul-fuerte: #55b9e8;
        --amarillo: #fff3c4;
        --naranja: #ff9c69;
        --texto: #354777;
        --blanco: #ffffff;
      }

      * { box-sizing: border-box; }

      html {
        min-height: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Trebuchet MS", Arial, Helvetica, sans-serif;
        color: var(--texto);
        background:
          radial-gradient(ellipse at 10% 25%, #fff5d7 0, transparent 35%),
          radial-gradient(ellipse at 95% 45%, #e2f5ff 0, transparent 30%),
          #fffaf2;
      }

      button, input { font: inherit; }
      button { -webkit-tap-highlight-color: transparent; }

      .pagina {
        width: min(1500px, 100%);
        margin: 0 auto;
        padding: 0 22px 18px;
      }

      .encabezado {
        position: relative;
        overflow: hidden;
        margin: 0 -22px 20px;
        padding: 20px 24px 25px;
        text-align: center;
        background: linear-gradient(120deg, #e0d5ff 0%, #fff0f8 48%, #dff8f4 100%);
        border-radius: 0 0 48% 5%;
      }

      .encabezado::after {
        content: "";
        position: absolute;
        bottom: -18px;
        left: -5%;
        width: 110%;
        height: 30px;
        background: #fffaf2;
        border-radius: 50% 50% 0 0;
      }

      .encabezado-interior {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(12px, 3vw, 40px);
      }

      .adorno-encabezado {
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: 1;
        filter: drop-shadow(0 5px 3px #b8a3d444);
      }

      .sobretitulo {
        margin: 0 0 4px;
        color: #7653c7;
        font-size: clamp(0.7rem, 1.4vw, 1rem);
        font-weight: 900;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .titulo-principal {
        margin: 0;
        font-size: clamp(2rem, 4.7vw, 4.5rem);
        font-weight: 1000;
        line-height: 1.04;
        letter-spacing: -0.04em;
        color: #7951cb;
        text-shadow: 2px 3px 0 #fff, 4px 5px 0 #c8b5ed;
      }

      .titulo-principal .rosa { color: #ef719f; }
      .titulo-principal .verde { color: #28a88b; }

      .subtitulo {
        margin: 10px 0 0;
        font-size: clamp(0.85rem, 1.6vw, 1.25rem);
        font-weight: 700;
        color: #536a9d;
      }

      .navegacion-secciones {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin: 0 auto 22px;
        padding: 10px;
      }

      .navegacion-secciones a {
        color: #7147a8;
        background: #fff;
        border: 1px solid #eadcf7;
        border-radius: 999px;
        padding: 10px 18px;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 5px 14px #5c3b8510;
      }

      .navegacion-secciones a:hover {
        background: #f7efff;
        transform: translateY(-1px);
      }

      .distribucion {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 20px;
        align-items: stretch;
      }

      .panel-tarjeta {
        min-width: 0;
        padding: clamp(12px, 2vw, 22px);
        background: linear-gradient(145deg, #fff 0%, #fffdf9 100%);
        border: 3px solid #ffe09a;
        border-radius: 30px;
        box-shadow: 0 10px 0 #f8ebd5, 0 15px 30px #8c7bb018;
      }

      .titulo-tarjeta {
        margin: 0 0 16px;
        text-align: center;
        color: #7553b9;
        font-size: clamp(1.3rem, 2.4vw, 2rem);
        font-weight: 1000;
      }

      .area-aprendizaje {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(12px, 1.7vw, 22px);
        align-items: stretch;
      }

      .marco-imagen {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 330px;
        overflow: hidden;
        padding: 15px;
        background: linear-gradient(145deg, #d5f6ff, #c5edfa);
        border: 3px solid #bdeaff;
        border-radius: 25px;
      }

      .marco-imagen::before,
      .marco-imagen::after {
        position: absolute;
        z-index: 0;
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        pointer-events: none;
      }

      .marco-imagen::before {
        content: "✦";
        top: 12px;
        left: 15px;
        color: #ffc84f;
      }

      .marco-imagen::after {
        content: "✿";
        right: 14px;
        bottom: 12px;
        color: #f58ab7;
      }

      #imagen-tarjeta {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        max-height: 440px;
        object-fit: contain;
        border-radius: 17px;
      }

      #imagen-tarjeta.hidden { display: none; }

      .imagen-vacia {
        position: relative;
        z-index: 1;
        padding: 20px 8px;
        text-align: center;
      }

      .imagen-vacia .emoji-vacio {
        margin-bottom: 14px;
        font-size: clamp(4rem, 8vw, 7rem);
      }

      .imagen-vacia h3 {
        margin: 0;
        color: #4b62a0;
        font-size: clamp(1.4rem, 2.5vw, 2.2rem);
        font-weight: 1000;
      }

      .imagen-vacia p {
        margin: 10px 0 0;
        color: #6579a6;
        font-weight: 700;
      }

      .palabras {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(12px, 1.7vw, 20px);
        min-width: 0;
      }

      .caja-palabra {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        min-height: 190px;
        padding: clamp(14px, 2vw, 26px);
        text-align: center;
        border-radius: 25px;
      }

      .caja-mazahua {
        background: linear-gradient(145deg, #f1ffeb, #e6f8df);
        border: 3px solid #d6f2cc;
      }

      .caja-espanol {
        background: linear-gradient(145deg, #fff5ec, #ffebdf);
        border: 3px solid #ffddcb;
      }

      .etiqueta-palabra {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin: 0 0 12px;
        font-size: clamp(0.85rem, 1.6vw, 1.35rem);
        font-weight: 1000;
      }

      .caja-mazahua .etiqueta-palabra { color: #28844a; }
      .caja-espanol .etiqueta-palabra { color: #e66b30; }
      .icono-palabra { font-size: 1.5em; }

      .palabra-grande {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: clamp(2.2rem, 4.3vw, 4.7rem);
        font-weight: 1000;
        line-height: 1.06;
        letter-spacing: -0.035em;
      }

      #mazahua { color: #19813d; }
      #espanol { color: #ef681e; }

      .zona-audio {
        margin-top: 18px;
        text-align: center;
      }

      .boton-reproducir {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        width: min(100%, 720px);
        min-height: 86px;
        margin: 0 auto;
        padding: 17px 22px;
        color: white;
        background: linear-gradient(135deg, #b08af8, #8054dc);
        border: 3px solid #9b76ed;
        border-radius: 999px;
        box-shadow: 0 7px 0 #d7c4ff;
        font-size: clamp(1.15rem, 2.4vw, 2rem);
        font-weight: 1000;
        cursor: pointer;
        transition: transform 0.18s, box-shadow 0.18s, filter 0.18s;
      }

      .boton-reproducir:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 10px 0 #d7c4ff;
        filter: brightness(1.04);
      }

      .boton-reproducir:active:not(:disabled) {
        transform: translateY(3px);
        box-shadow: 0 3px 0 #d7c4ff;
      }

      .boton-reproducir:focus-visible,
      .boton-volumen:focus-visible {
        outline: 4px solid #4caee5;
        outline-offset: 4px;
      }

      .boton-reproducir:disabled {
        cursor: not-allowed;
        opacity: 0.58;
      }

      .icono-audio {
        font-size: clamp(2rem, 4vw, 3.3rem);
        line-height: 1;
      }

      .ayuda-audio {
        margin: 12px 0 0;
        color: #8871c4;
        font-size: 0.9rem;
        font-weight: 700;
      }

      .seccion-extra {
        margin: 26px 0;
        padding: clamp(18px, 3vw, 30px);
        background: #fff;
        border: 1px solid #efe5f7;
        border-radius: 28px;
        box-shadow: 0 12px 32px #573d7810;
      }

      .encabezado-seccion {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 22px;
      }

      .encabezado-seccion h2 {
        margin: 5px 0 8px;
        color: #6944a3;
        font-size: clamp(1.5rem, 3vw, 2.15rem);
      }

      .encabezado-seccion p {
        color: #776b8b;
        line-height: 1.6;
        margin: 0;
      }

      .sobretitulo-extra {
        color: #d65c9a !important;
        font-weight: 1000;
        letter-spacing: .13em;
        font-size: .72rem;
      }

      .barra-catalogo {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin: 20px 0;
      }

      .busqueda-catalogo {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        max-width: 600px;
        padding: 12px 16px;
        background: #faf7ff;
        border: 1px solid #e8dcf5;
        border-radius: 16px;
      }

      .busqueda-catalogo input {
        width: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: #493b5e;
        font: inherit;
      }

      .contador-catalogo {
        color: #765b9d;
        font-weight: 900;
        white-space: nowrap;
      }

      .rejilla-catalogo {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(205px, 1fr));
        gap: 17px;
      }

      .tarjeta-catalogo {
        overflow: hidden;
        background: #fff;
        border: 1px solid #eee4f5;
        border-radius: 20px;
        box-shadow: 0 7px 20px #4c32670c;
        display: flex;
        flex-direction: column;
      }

      .tarjeta-catalogo img {
        width: 100%;
        height: 165px;
        object-fit: contain;
        padding: 12px;
        background: #fbf8ff;
      }

      .contenido-catalogo {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex: 1;
      }

      .contenido-catalogo h3 {
        margin: 0;
        color: #6846a0;
        font-size: 1.15rem;
      }

      .contenido-catalogo .mazahua-catalogo {
        margin: 0;
        color: #24845b;
        font-size: 1.08rem;
        font-weight: 900;
        overflow-wrap: anywhere;
      }

      .contenido-catalogo .codigo-catalogo {
        color: #9588a5;
        font-size: .72rem;
      }

      .boton-audio-catalogo {
        margin-top: auto;
        border: 0;
        border-radius: 12px;
        padding: 10px;
        background: #f5eafa;
        color: #70449d;
        font-weight: 900;
        cursor: pointer;
      }

      .boton-audio-catalogo:disabled {
        opacity: .5;
        cursor: not-allowed;
      }

      .mensaje-catalogo {
        grid-column: 1 / -1;
        text-align: center;
        color: #796b8a;
        padding: 25px;
      }

      .seccion-simulador {
        background: linear-gradient(135deg, #fff9fd, #f7f5ff);
      }

      .panel-simulador {
        max-width: 850px;
        margin: auto;
        padding: clamp(15px, 3vw, 25px);
        border-radius: 24px;
        background: #fff;
        border: 1px solid #eee1f6;
      }

      .controles-simulador {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
      }

      .boton-simulador {
        border: 0;
        border-radius: 14px;
        padding: 12px 19px;
        background: #7650b2;
        color: white;
        font: inherit;
        font-weight: 900;
        cursor: pointer;
      }

      .boton-simulador:hover:not(:disabled) {
        filter: brightness(1.06);
        transform: translateY(-1px);
      }

      .boton-simulador:disabled {
        opacity: .45;
        cursor: not-allowed;
      }

      .boton-secundario {
        color: #704b9e;
        background: #f2eafa;
      }

      .estado-simulador {
        text-align: center;
        color: #796b8a;
        font-weight: 800;
        min-height: 24px;
        margin: 18px 0;
      }

      .tarjeta-simulada {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        align-items: center;
        max-width: 680px;
        margin: 15px auto;
        padding: 15px;
        border: 2px dashed #e3d3f1;
        border-radius: 22px;
      }

      .imagen-simulada {
        min-height: 220px;
        display: grid;
        place-items: center;
        background: #fbf8ff;
        border-radius: 16px;
      }

      .imagen-simulada img {
        width: 100%;
        max-height: 260px;
        object-fit: contain;
      }

      .datos-simulados {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .etiqueta-simulada {
        color: #a17bbd;
        font-size: .7rem;
        font-weight: 1000;
        letter-spacing: .1em;
      }

      .datos-simulados h3 {
        margin: 0 0 10px;
        color: #21845b;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        overflow-wrap: anywhere;
      }

      .datos-simulados p {
        margin: 0 0 12px;
        color: #7046a4;
        font-size: clamp(1.35rem, 3vw, 1.8rem);
        font-weight: 1000;
      }

      .boton-audio-simulado {
        border: 0;
        border-radius: 12px;
        padding: 11px;
        background: #e9f7ee;
        color: #247a4d;
        font: inherit;
        font-weight: 900;
        cursor: pointer;
      }

      .progreso-simulador {
        margin-top: 20px;
        color: #796b8a;
        font-size: .85rem;
        font-weight: 800;
      }

      .barra-progreso {
        height: 10px;
        overflow: hidden;
        margin-top: 8px;
        background: #eee8f5;
        border-radius: 20px;
      }

      .barra-progreso div {
        width: 0;
        height: 100%;
        background: linear-gradient(90deg, #e88bb8, #8e70c8);
        transition: width .25s;
      }

      .rejilla-youtube {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
      }

      .youtube-card {
        overflow: hidden;
        border: 1px solid #eee3f5;
        border-radius: 18px;
        background: #fff;
      }

      .youtube-card iframe {
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 0;
        display: block;
      }

      .youtube-card p {
        padding: 12px;
        margin: 0;
        color: #704a9f;
        font-weight: 900;
      }

      .youtube-vacio {
        text-align: center;
        padding: 25px;
        border: 2px dashed #e5d8f0;
        border-radius: 20px;
        color: #786a8a;
      }

      .youtube-vacio span { font-size: 2.4rem; }
      .youtube-vacio h3 { color: #704a9f; margin: 8px 0; }
      .youtube-vacio p { line-height: 1.6; margin: 0; }

      .volumen-inferior {
        display: flex;
        justify-content: center;
        width: 100%;
        margin: 28px auto 22px;
      }

      .volumen-compacto {
        width: min(100%, 340px);
        padding: 12px 18px;
        background: #fff;
        border: 1px solid #e4dff0;
        border-radius: 16px;
        box-shadow: 0 3px 12px #5c3b850c;
      }

      .volumen-compacto .encabezado-volumen {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
      }

      .volumen-compacto .icono-volumen { font-size: 1.15rem; }
      .volumen-compacto .encabezado-volumen h2 {
        margin: 0;
        color: #536b9c;
        font-size: .95rem;
      }

      .volumen-compacto .numero-volumen {
        margin: 0;
        color: #536b9c;
        font-size: .85rem;
        font-weight: 800;
      }

      .volumen-compacto #control-volumen {
        display: block;
        width: 100%;
        margin: 8px 0 0;
        accent-color: #9874d1;
      }

      .volumen-compacto .rango-volumen {
        display: flex;
        justify-content: space-between;
        color: #8994aa;
        font-size: .68rem;
      }

      .volumen-compacto .botones-volumen {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 8px;
      }

      .volumen-compacto .boton-volumen {
        width: 34px;
        min-height: 30px;
        height: 30px;
        padding: 0;
        border-radius: 9px;
        font-size: 1.15rem;
        box-shadow: none;
        border: 0;
        cursor: pointer;
      }

      .volumen-compacto .boton-menos {
        background: #f1dce8;
        color: #a34e78;
      }

      .volumen-compacto .boton-mas {
        background: #d9f0e6;
        color: #348568;
      }

      .volumen-compacto .estado-volumen {
        margin: 6px 0 0;
        color: #78859b;
        font-size: .67rem;
        text-align: center;
      }

      .pie {
        position: relative;
        margin-top: 23px;
        padding: 18px 12px 8px;
        text-align: center;
        color: #7554bd;
        font-size: .9rem;
        font-weight: 800;
      }

      .pie .corazon { color: #f276a6; }

      /* En esta página solo se muestra la sección de videos */
      body.pagina-videos .distribucion,
      body.pagina-videos #catalogo,
      body.pagina-videos #simulador {
        display: none;
      }

      body.pagina-videos #muestras { display: block; }

      @media (max-width: 900px) {
        .area-aprendizaje { grid-template-columns: minmax(0, 1fr); }
        .marco-imagen { min-height: 300px; }
        #imagen-tarjeta { max-height: 360px; }
        .palabras { display: grid; grid-template-columns: 1fr 1fr; }
        .caja-palabra { min-height: 155px; }
        .palabra-grande { font-size: clamp(2rem, 4vw, 3rem); }
      }

      @media (max-width: 650px) {
        .pagina { padding: 0 12px 14px; }

        .encabezado {
          margin: 0 -12px 15px;
          padding: 22px 12px 25px;
          border-radius: 0 0 30px 30px;
        }

        .encabezado-interior { gap: 8px; }
        .adorno-encabezado { font-size: 2.1rem; }

        .titulo-principal {
          font-size: clamp(1.65rem, 7vw, 2.5rem);
        }

        .sobretitulo {
          font-size: .62rem;
          letter-spacing: .1em;
        }

        .subtitulo { font-size: .8rem; }

        .area-aprendizaje { grid-template-columns: minmax(0, 1fr); }
        .marco-imagen {
          min-height: 230px;
          max-height: 350px;
          padding: 10px;
          border-radius: 19px;
        }

        #imagen-tarjeta { max-height: 320px; }

        .palabras {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 9px;
        }

        .caja-palabra {
          min-height: 140px;
          padding: 13px 8px;
          border-radius: 19px;
        }

        .etiqueta-palabra {
          flex-direction: column;
          gap: 4px;
          margin-bottom: 10px;
          font-size: .8rem;
        }

        .palabra-grande { font-size: clamp(1.6rem, 7vw, 2.6rem); }

        .boton-reproducir {
          min-height: 68px;
          gap: 9px;
          padding: 12px 10px;
          font-size: clamp(1rem, 4.5vw, 1.4rem);
        }

        .icono-audio { font-size: 2rem; }
        .ayuda-audio { font-size: .8rem; line-height: 1.5; }

        .barra-catalogo {
          align-items: stretch;
          flex-direction: column;
        }

        .busqueda-catalogo { max-width: none; }

        .rejilla-catalogo {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
        }

        .tarjeta-catalogo img { height: 130px; }
        .contenido-catalogo { padding: 10px; }
        .contenido-catalogo h3 { font-size: 1rem; }

        .tarjeta-simulada { grid-template-columns: 1fr; }
        .imagen-simulada { min-height: 180px; }

        .pie {
          margin-top: 18px;
          line-height: 1.6;
        }
      }

      @media (max-width: 380px) {
        .rejilla-catalogo { grid-template-columns: 1fr; }
      }

      @media (max-width: 360px) {
        .adorno-encabezado { font-size: 1.7rem; }
        .palabra-grande { font-size: 1.45rem; }
        .caja-palabra { min-height: 125px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: .01ms !important;
        }
      }
    </style>
  </head>

  <body class="pagina-videos">
    <div class="pagina" id="inicio">
      <header class="encabezado">
        <div class="encabezado-interior">
          <span class="adorno-encabezado" aria-hidden="true">🐦</span>
          <div>
            <p class="sobretitulo">¡Aprendemos jugando!</p>
            <h1 class="titulo-principal">
              <span class="rosa">Lotería</span>
              <span class="verde">Mazahua</span>
            </h1>
            <p class="subtitulo">Aprende palabras en mazahua y español</p>
          </div>
          <span class="adorno-encabezado" aria-hidden="true">🌽</span>
        </div>
      </header>

     <nav class="navegacion-secciones" aria-label="Navegación principal">
  <a href={BASE_PATH}>Inicio</a>
  <a href={`${BASE_PATH}catalogo/`}>Catálogo</a>
  <a href={`${BASE_PATH}jugar/`}>Jugar</a>
  <a href={`${BASE_PATH}videos/`}>Videos</a>
</nav>
      <!-- Elementos internos requeridos por el JavaScript -->
      <div hidden aria-hidden="true">
        <span id="estado-icono">📡</span>
        <p id="estado">Conectando con el juego...</p>
        <span id="conexion">Conectando...</span>

        <input id="control-volumen" type="range" min="0" max="30" value="20" />
        <div id="valor-volumen">20/30</div>
        <p id="estado-volumen">Volumen</p>
        <button id="volumen-menos" type="button">-</button>
        <button id="volumen-mas" type="button">+</button>
      </div>

      <main class="distribucion">
        <section class="panel-tarjeta" aria-label="Tarjeta de aprendizaje">
          <h2 class="titulo-tarjeta">✨ ¡Mira y aprende! ✨</h2>
          <div class="area-aprendizaje">
            <div class="marco-imagen">
              <img id="imagen-tarjeta" class="hidden" alt="Imagen de la tarjeta de lotería" />
              <div id="imagen-vacia" class="imagen-vacia">
                <div class="emoji-vacio" aria-hidden="true">🎴</div>
                <h3>¡Acerca tu tarjeta!</h3>
                <p>¿Qué palabra descubriremos?</p>
              </div>
            </div>

            <div class="palabras">
              <article class="caja-palabra caja-mazahua">
                <p class="etiqueta-palabra">
                  <span class="icono-palabra" aria-hidden="true">🌿</span>
                  <span>En mazahua</span>
                </p>
                <h3 id="mazahua" class="palabra-grande">¡Bätsi!</h3>
              </article>

              <article class="caja-palabra caja-espanol">
                <p class="etiqueta-palabra">
                  <span class="icono-palabra" aria-hidden="true">☀️</span>
                  <span>En español</span>
                </p>
                <p id="espanol" class="palabra-grande">¡Vamos a aprender!</p>
              </article>
            </div>
          </div>

          <div class="zona-audio">
            <button id="boton-audio" type="button" disabled class="boton-reproducir">
              <span class="icono-audio" aria-hidden="true">🔊</span>
              <span id="texto-boton-audio">Acerca una tarjeta</span>
            </button>
            <p class="ayuda-audio">
              Puedes volver a reproducir el audio cuantas veces quieras. 💜
            </p>
          </div>
        </section>
      </main>

      <section class="seccion-extra" id="catalogo">
        <div class="encabezado-seccion">
          <p class="sobretitulo-extra">CONOCE NUESTRAS PALABRAS</p>
          <h2>📚 Catálogo de la lotería</h2>
          <p>Explora las tarjetas, observa sus imágenes y escucha su pronunciación en mazahua.</p>
        </div>

        <div class="barra-catalogo">
          <label class="busqueda-catalogo">
            <span aria-hidden="true">🔎</span>
            <input id="buscar-tarjeta" type="search" placeholder="Buscar en español, mazahua o código RFID..." aria-label="Buscar tarjetas" />
          </label>
          <span id="contador-catalogo" class="contador-catalogo">Cargando tarjetas...</span>
        </div>

        <div id="catalogo-tarjetas" class="rejilla-catalogo" aria-live="polite">
          <p class="mensaje-catalogo">Conectando con el catálogo de FastAPI...</p>
        </div>
      </section>

      <section class="seccion-extra seccion-simulador" id="simulador">
        <div class="encabezado-seccion">
          <p class="sobretitulo-extra">PRACTICA DESDE TU NAVEGADOR</p>
          <h2>🎴 Simulador de lotería</h2>
          <p>Inicia una partida y descubre las tarjetas al azar. Puedes escuchar la pronunciación de cada palabra.</p>
        </div>

        <div class="panel-simulador">
          <div class="controles-simulador">
            <button id="iniciar-partida" class="boton-simulador" type="button">▶ Iniciar partida</button>
            <button id="siguiente-tarjeta" class="boton-simulador boton-secundario" type="button" disabled>🎲 Siguiente tarjeta</button>
            <button id="reiniciar-partida" class="boton-simulador boton-secundario" type="button" disabled>↻ Reiniciar</button>
          </div>

          <p id="estado-simulador" class="estado-simulador" role="status" aria-live="polite">
            Presiona “Iniciar partida” para comenzar.
          </p>

          <article id="tarjeta-simulada" class="tarjeta-simulada" hidden>
            <div class="imagen-simulada">
              <img id="imagen-simulada" alt="Imagen de la tarjeta seleccionada en la simulación" />
            </div>
            <div class="datos-simulados">
              <span class="etiqueta-simulada">PALABRA EN MAZAHUA</span>
              <h3 id="mazahua-simulado">—</h3>
              <span class="etiqueta-simulada">PALABRA EN ESPAÑOL</span>
              <p id="espanol-simulado">—</p>
              <button id="audio-simulado" class="boton-audio-simulado" type="button">🔊 Escuchar pronunciación</button>
            </div>
          </article>

          <div class="progreso-simulador">
            <span id="progreso-texto">0 tarjetas descubiertas</span>
            <div class="barra-progreso"><div id="progreso-relleno"></div></div>
          </div>
        </div>
      </section>

      <section class="seccion-extra" id="muestras">
        <div class="encabezado-seccion">
          <p class="sobretitulo-extra">ASÍ FUNCIONA EL PROYECTO</p>
          <h2>▶ Muestras en YouTube</h2>
          <p>Videos demostrativos de la lotería interactiva, el reconocimiento RFID y el aprendizaje de palabras mazahuas.</p>
        </div>

        <div id="youtube-muestras" class="rejilla-youtube">
          <article class="youtube-vacio">
            <span aria-hidden="true">🎥</span>
            <h3>Agrega tus videos de muestra</h3>
            <p>Cuando tengas los enlaces de YouTube de tu demostración, se colocarán aquí para que puedan reproducirse desde la página.</p>
          </article>
        </div>
      </section>

      <footer class="pie">
        <p>
          Lotería Interactiva Mazahua · Aprende y comparte nuestra cultura
          <span class="corazon" aria-label="con cariño">♥</span>
        </p>
      </footer>
    </div>

    <script>
      const API_BASE = "https://loteria-mazahua-backend-2026.onrender.com";

      const API_URL = `${API_BASE}/api/tarjeta-actual`;
      const VOLUMEN_URL = `${API_BASE}/api/volumen`;
      const REPRODUCIR_URL = `${API_BASE}/api/reproducir-audio`;

      const estado = document.querySelector<HTMLParagraphElement>("#estado")!;
      const estadoIcono = document.querySelector<HTMLSpanElement>("#estado-icono")!;
      const conexion = document.querySelector<HTMLSpanElement>("#conexion")!;

      const imagen = document.querySelector<HTMLImageElement>("#imagen-tarjeta")!;
      const imagenVacia = document.querySelector<HTMLDivElement>("#imagen-vacia")!;
      const mazahua = document.querySelector<HTMLHeadingElement>("#mazahua")!;
      const espanol = document.querySelector<HTMLParagraphElement>("#espanol")!;

      const botonAudio = document.querySelector<HTMLButtonElement>("#boton-audio")!;
      const textoBotonAudio = document.querySelector<HTMLSpanElement>("#texto-boton-audio")!;

      const controlVolumen = document.querySelector<HTMLInputElement>("#control-volumen")!;
      const valorVolumen = document.querySelector<HTMLDivElement>("#valor-volumen")!;
      const estadoVolumen = document.querySelector<HTMLParagraphElement>("#estado-volumen")!;
      const botonMenos = document.querySelector<HTMLButtonElement>("#volumen-menos")!;
      const botonMas = document.querySelector<HTMLButtonElement>("#volumen-mas")!;

      let uidActual = "";
      let ultimaTarjeta = "";
      let volumenActual = 20;
      let actualizacionVolumenEnCurso = false;
      let reproduccionEnCurso = false;
      let contadorReproduccion = 0;
      let ultimaActualizacionVolumen = 0;

      function mostrarEstado(texto: string, icono: string, conectado: boolean) {
        estado.textContent = texto;
        estadoIcono.textContent = icono;
        conexion.textContent = conectado ? "Servidor conectado" : "Sin conexión";
        conexion.style.background = conectado ? "#e1f8e9" : "#fff0d7";
        conexion.style.color = conectado ? "#19834d" : "#a56318";
      }

      async function consultarTarjeta() {
        try {
          const respuesta = await fetch(API_URL, {
            cache: "no-store",
            signal: AbortSignal.timeout(4000),
          });

          if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);

          const datos: {
            uid?: string;
            mazahua?: string;
            espanol?: string;
            imagen?: string | null;
            encontrada?: boolean;
          } = await respuesta.json();

          if (!datos.uid || !datos.mazahua || !datos.espanol) {
            uidActual = "";
            ultimaTarjeta = "";
            botonAudio.disabled = true;
            textoBotonAudio.textContent = "Acerca una tarjeta";

            mostrarEstado(
              datos.encontrada === false
                ? "Esa tarjeta no está registrada."
                : "¡Listo para aprender! Acerca una tarjeta RFID.",
              datos.encontrada === false ? "🔎" : "📡",
              true,
            );
            return;
          }

          const nuevoUID = String(datos.uid).replace(/[^a-zA-Z0-9]/g, "").toUpperCase();
          const identificador = [
            nuevoUID,
            datos.mazahua,
            datos.espanol,
            datos.imagen ?? "",
          ].join("-");

          uidActual = nuevoUID;
          mostrarEstado("¡Descubrimos una nueva palabra!", "🎉", true);

          if (identificador === ultimaTarjeta) return;

          ultimaTarjeta = identificador;
          botonAudio.disabled = false;
          textoBotonAudio.textContent = "Escuchar palabra";
          mazahua.textContent = datos.mazahua;
          espanol.textContent = datos.espanol;

          if (datos.imagen) {
            imagen.onload = () => {
              imagen.classList.remove("hidden");
              imagenVacia.style.display = "none";
            };
            imagen.onerror = () => {
              imagen.classList.add("hidden");
              imagenVacia.style.display = "block";
            };
            imagen.src = new URL(datos.imagen, API_BASE).href;
          } else {
            imagen.removeAttribute("src");
            imagen.classList.add("hidden");
            imagenVacia.style.display = "block";
          }
        } catch (error) {
          console.error("Error consultando tarjeta:", error);
          mostrarEstado("No se pudo conectar con el servidor.", "⚠️", false);
        }
      }

      async function reproducirAudio() {
        if (!uidActual || reproduccionEnCurso) return;

        reproduccionEnCurso = true;
        const solicitud = ++contadorReproduccion;
        botonAudio.disabled = true;
        textoBotonAudio.textContent = "¡Enviando audio! 🎵";

        try {
          const respuesta = await fetch(REPRODUCIR_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ uid: uidActual, solicitud }),
            cache: "no-store",
            signal: AbortSignal.timeout(5000),
          });

          if (!respuesta.ok) {
            const detalle = await respuesta.text();
            throw new Error(`HTTP ${respuesta.status}: ${detalle}`);
          }

          estado.textContent = "¡Orden enviada al reproductor! 🎵";
          textoBotonAudio.textContent = "¡Escuchar otra vez!";
        } catch (error) {
          console.error("Error solicitando reproducción:", error);
          estado.textContent = "No se pudo enviar el audio. Comprueba la conexión con FastAPI.";
          textoBotonAudio.textContent = "Intentar otra vez";
        } finally {
          reproduccionEnCurso = false;
          botonAudio.disabled = !uidActual;
        }
      }

      function pintarVolumen(nivel: number) {
        volumenActual = Math.max(0, Math.min(30, Math.round(nivel)));
        controlVolumen.value = String(volumenActual);
        valorVolumen.textContent = `${volumenActual}/30`;
        botonMenos.disabled = volumenActual <= 0;
        botonMas.disabled = volumenActual >= 30;
      }

      async function consultarVolumen() {
        if (actualizacionVolumenEnCurso) return;

        try {
          const respuesta = await fetch(VOLUMEN_URL, {
            cache: "no-store",
            signal: AbortSignal.timeout(3000),
          });

          if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);

          const nivel = Number((await respuesta.text()).trim());
          if (!Number.isFinite(nivel) || nivel < 0 || nivel > 30) {
            throw new Error("El servidor devolvió un volumen inválido.");
          }

          if (
            document.activeElement !== controlVolumen &&
            Date.now() - ultimaActualizacionVolumen > 1200
          ) {
            pintarVolumen(nivel);
          }

          estadoVolumen.textContent = `🟢 Volumen del reproductor: ${nivel}/30`;
          estadoVolumen.style.color = "#19834d";
        } catch (error) {
          console.error("Error consultando volumen:", error);
          estadoVolumen.textContent = "⚠️ No se pudo consultar el volumen.";
          estadoVolumen.style.color = "#b45309";
        }
      }

      async function establecerVolumen(nivel: number) {
        if (actualizacionVolumenEnCurso) return;

        const nivelSeguro = Math.max(0, Math.min(30, Math.round(nivel)));
        actualizacionVolumenEnCurso = true;
        ultimaActualizacionVolumen = Date.now();
        pintarVolumen(nivelSeguro);
        estadoVolumen.textContent = "🔄 Cambiando volumen...";
        estadoVolumen.style.color = "#5c719f";

        try {
          const respuesta = await fetch(`${VOLUMEN_URL}/${nivelSeguro}`, {
            method: "POST",
            cache: "no-store",
            signal: AbortSignal.timeout(4000),
          });

          if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);

          const datos: { volumen?: number } = await respuesta.json();
          pintarVolumen(Number(datos.volumen ?? nivelSeguro));
          estadoVolumen.textContent = `🟢 ¡Volumen actualizado! ${volumenActual}/30`;
          estadoVolumen.style.color = "#19834d";
        } catch (error) {
          console.error("Error actualizando volumen:", error);
          estadoVolumen.textContent = "⚠️ No se pudo cambiar el volumen.";
          estadoVolumen.style.color = "#b45309";
        } finally {
          actualizacionVolumenEnCurso = false;
        }
      }

      botonAudio.addEventListener("click", () => void reproducirAudio());

      controlVolumen.addEventListener("input", () => {
        const nivel = Number(controlVolumen.value);
        volumenActual = nivel;
        valorVolumen.textContent = `${nivel}/30`;
        botonMenos.disabled = nivel <= 0;
        botonMas.disabled = nivel >= 30;
      });

      controlVolumen.addEventListener("change", () => {
        void establecerVolumen(Number(controlVolumen.value));
      });

      botonMenos.addEventListener("click", () => void establecerVolumen(volumenActual - 2));
      botonMas.addEventListener("click", () => void establecerVolumen(volumenActual + 2));

      pintarVolumen(20);
      void consultarTarjeta();
      void consultarVolumen();

      window.setInterval(() => void consultarTarjeta(), 1000);
      window.setInterval(() => void consultarVolumen(), 2000);

      // CATÁLOGO
      const CATALOGO_URL = `${API_BASE}/api/admin/tarjetas/`;
      const contenedorCatalogo = document.querySelector<HTMLDivElement>("#catalogo-tarjetas")!;
      const buscarTarjeta = document.querySelector<HTMLInputElement>("#buscar-tarjeta")!;
      const contadorCatalogo = document.querySelector<HTMLSpanElement>("#contador-catalogo")!;
      const audioCatalogo = new Audio();
      let tarjetasCatalogo: any[] = [];

      function urlMultimedia(ruta: string | null | undefined): string {
        if (!ruta) return "";
        return new URL(ruta, API_BASE).href;
      }

      function reproducirArchivo(ruta: string | null | undefined, boton?: HTMLButtonElement) {
        if (!ruta) {
          if (boton) boton.textContent = "Audio no disponible";
          return;
        }

        audioCatalogo.pause();
        audioCatalogo.src = urlMultimedia(ruta);
        audioCatalogo.currentTime = 0;

        void audioCatalogo.play().catch((error) => {
          console.error("No se pudo reproducir el audio:", error);
          if (boton) boton.textContent = "No se pudo reproducir";
        });

        if (boton) {
          boton.textContent = "🔊 Reproduciendo...";
          audioCatalogo.onended = () => {
            boton.textContent = "🔊 Escuchar pronunciación";
          };
        }
      }

      function pintarCatalogo(lista: any[]) {
        contenedorCatalogo.innerHTML = "";
        contadorCatalogo.textContent = `${lista.length} tarjetas`;

        if (!lista.length) {
          contenedorCatalogo.innerHTML = '<p class="mensaje-catalogo">No se encontraron tarjetas.</p>';
          return;
        }

        lista.forEach((tarjeta) => {
          const articulo = document.createElement("article");
          articulo.className = "tarjeta-catalogo";

          const foto = document.createElement("img");
          foto.alt = `Imagen de ${tarjeta.espanol || "tarjeta"}`;
          foto.loading = "lazy";
          foto.src = tarjeta.imagen ? urlMultimedia(tarjeta.imagen) : "/favicon.svg";
          foto.onerror = () => { foto.src = "/favicon.svg"; };

          const contenido = document.createElement("div");
          contenido.className = "contenido-catalogo";

          const esp = document.createElement("h3");
          esp.textContent = tarjeta.espanol || "Sin traducción";

          const maz = document.createElement("p");
          maz.className = "mazahua-catalogo";
          maz.textContent = tarjeta.mazahua || "Sin palabra mazahua";

          const codigo = document.createElement("span");
          codigo.className = "codigo-catalogo";
          codigo.textContent = `RFID: ${tarjeta.codigo || "No disponible"}`;

          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "boton-audio-catalogo";
          boton.textContent = tarjeta.audio ? "🔊 Escuchar pronunciación" : "Audio no disponible";
          boton.disabled = !tarjeta.audio;
          boton.addEventListener("click", () => reproducirArchivo(tarjeta.audio, boton));

          contenido.append(esp, maz, codigo, boton);
          articulo.append(foto, contenido);
          contenedorCatalogo.append(articulo);
        });
      }

      async function cargarCatalogo() {
        try {
          const respuesta = await fetch(CATALOGO_URL, {
            cache: "no-store",
            signal: AbortSignal.timeout(8000),
          });

          if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);

          const datos = await respuesta.json();
          if (!Array.isArray(datos)) throw new Error("El endpoint no devolvió una lista.");

          tarjetasCatalogo = datos;
          pintarCatalogo(tarjetasCatalogo);
        } catch (error) {
          console.error("Error cargando catálogo:", error);
          contadorCatalogo.textContent = "Sin conexión";
          contenedorCatalogo.innerHTML =
            '<p class="mensaje-catalogo">No fue posible cargar el catálogo. Verifica que FastAPI esté activo y que el endpoint GET /api/admin/tarjetas/ responda.</p>';
        }
      }

      buscarTarjeta.addEventListener("input", () => {
        const termino = buscarTarjeta.value.trim().toLocaleLowerCase();

        const filtradas = tarjetasCatalogo.filter((t) =>
          [t.espanol, t.mazahua, t.codigo, t.categoria].some((valor) =>
            String(valor ?? "").toLocaleLowerCase().includes(termino)
          )
        );

        pintarCatalogo(filtradas);
      });

      // SIMULADOR
      const iniciarPartida = document.querySelector<HTMLButtonElement>("#iniciar-partida")!;
      const siguienteTarjeta = document.querySelector<HTMLButtonElement>("#siguiente-tarjeta")!;
      const reiniciarPartida = document.querySelector<HTMLButtonElement>("#reiniciar-partida")!;
      const estadoSimulador = document.querySelector<HTMLParagraphElement>("#estado-simulador")!;
      const tarjetaSimulada = document.querySelector<HTMLElement>("#tarjeta-simulada")!;
      const imagenSimulada = document.querySelector<HTMLImageElement>("#imagen-simulada")!;
      const mazahuaSimulado = document.querySelector<HTMLHeadingElement>("#mazahua-simulado")!;
      const espanolSimulado = document.querySelector<HTMLParagraphElement>("#espanol-simulado")!;
      const audioSimulado = document.querySelector<HTMLButtonElement>("#audio-simulado")!;
      const progresoTexto = document.querySelector<HTMLSpanElement>("#progreso-texto")!;
      const progresoRelleno = document.querySelector<HTMLDivElement>("#progreso-relleno")!;

      let mazo: any[] = [];
      let descubiertas = 0;
      let tarjetaActualSimulada: any = null;

      function actualizarProgreso() {
        progresoTexto.textContent = `${descubiertas} de ${mazo.length} tarjetas descubiertas`;
        progresoRelleno.style.width = mazo.length
          ? `${(descubiertas / mazo.length) * 100}%`
          : "0%";
      }

      function mostrarSiguienteTarjeta() {
        if (!mazo.length) return;

        if (descubiertas >= mazo.length) {
          estadoSimulador.textContent = "🎉 ¡Terminaste la partida! Descubriste todas las tarjetas.";
          siguienteTarjeta.disabled = true;
          return;
        }

        tarjetaActualSimulada = mazo[descubiertas];
        descubiertas += 1;

        mazahuaSimulado.textContent = tarjetaActualSimulada.mazahua || "Sin palabra mazahua";
        espanolSimulado.textContent = tarjetaActualSimulada.espanol || "Sin traducción";

        if (tarjetaActualSimulada.imagen) {
          imagenSimulada.src = urlMultimedia(tarjetaActualSimulada.imagen);
          imagenSimulada.alt = `Imagen de ${tarjetaActualSimulada.espanol}`;
          imagenSimulada.style.visibility = "visible";
        } else {
          imagenSimulada.removeAttribute("src");
          imagenSimulada.style.visibility = "hidden";
        }

        audioSimulado.disabled = !tarjetaActualSimulada.audio;
        audioSimulado.textContent = tarjetaActualSimulada.audio
          ? "🔊 Escuchar pronunciación"
          : "Audio no disponible";

        estadoSimulador.textContent = `Tarjeta ${descubiertas}: ¡observa, lee y aprende!`;
        siguienteTarjeta.disabled = descubiertas >= mazo.length;
        actualizarProgreso();
      }

      iniciarPartida.addEventListener("click", () => {
        if (!tarjetasCatalogo.length) {
          estadoSimulador.textContent = "Primero espera a que cargue el catálogo desde FastAPI.";
          return;
        }

        mazo = [...tarjetasCatalogo].sort(() => Math.random() - 0.5);
        descubiertas = 0;
        tarjetaSimulada.hidden = false;
        iniciarPartida.disabled = true;
        siguienteTarjeta.disabled = false;
        reiniciarPartida.disabled = false;
        mostrarSiguienteTarjeta();
      });

      siguienteTarjeta.addEventListener("click", mostrarSiguienteTarjeta);

      reiniciarPartida.addEventListener("click", () => {
        mazo = [...tarjetasCatalogo].sort(() => Math.random() - 0.5);
        descubiertas = 0;
        mostrarSiguienteTarjeta();
        estadoSimulador.textContent = "🔄 Nueva partida. ¡Buena suerte!";
      });

      audioSimulado.addEventListener("click", () => {
        if (tarjetaActualSimulada?.audio) {
          reproducirArchivo(tarjetaActualSimulada.audio, audioSimulado);
        }
      });

      // VIDEOS DE YOUTUBE
      const YOUTUBE_VIDEOS: { titulo: string; url: string }[] = [
        {
          titulo: "Demostración de la Lotería Interactiva Mazahua",
          url: "https://youtu.be/KW2LOH91OIo",
        },
      ];

      const zonaYoutube = document.querySelector<HTMLDivElement>("#youtube-muestras")!;

      if (YOUTUBE_VIDEOS.length) {
        zonaYoutube.innerHTML = "";

        YOUTUBE_VIDEOS.forEach((video) => {
          const id = video.url.match(
            /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/
          )?.[1];

          if (!id) return;

          const tarjeta = document.createElement("article");
          tarjeta.className = "youtube-card";

          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}`;
          iframe.title = video.titulo;
          iframe.loading = "lazy";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;

          const titulo = document.createElement("p");
          titulo.textContent = video.titulo;

          tarjeta.append(iframe, titulo);
          zonaYoutube.append(tarjeta);
        });
      }

      void cargarCatalogo();
    </script>
  </body>
</html>
